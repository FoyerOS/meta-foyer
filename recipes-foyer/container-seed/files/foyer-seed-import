#!/bin/sh
#
# Import the container images carried by the active seed slot into podman's
# storage on the data partition.
#
# The previous implementation deleted the tarball after loading it and dropped
# a single marker, which mutated the rootfs and made the image unusable for A/B
# updates. Here nothing is ever deleted, and markers live on the data partition
# keyed by image name *and* version:
#
#   * booting a new slot carrying a newer image finds no marker for that
#     version and imports it;
#   * rolling back to the old slot finds the old marker still present and does
#     nothing, so a rollback is not paid for with a re-import.

set -u

SEED_DIR=/usr/share/foyer/seed
MANIFEST="$SEED_DIR/seed.manifest"
MARKER_DIR=/var/lib/foyer/imported

log() {
    echo "foyer-seed-import: $*"
}

if [ ! -r "$MANIFEST" ]; then
    log "no manifest at $MANIFEST, nothing to import"
    exit 0
fi

# /var/tmp is a symlink into the volatile tmpfs and is far too small for
# multi-hundred-megabyte image loads. Point podman at real disk on the data
# partition instead.
TMPDIR=/var/lib/foyer/tmp
export TMPDIR
mkdir -p "$TMPDIR" "$MARKER_DIR"

rc=0
while read -r name version file; do
    [ -n "$name" ] || continue
    case "$name" in \#*) continue ;; esac

    marker="$MARKER_DIR/$name-$version"
    if [ -e "$marker" ]; then
        log "$name $version already imported"
        continue
    fi

    if [ ! -r "$SEED_DIR/$file" ]; then
        log "WARNING: $SEED_DIR/$file missing, skipping $name $version"
        rc=1
        continue
    fi

    log "importing $name $version from $file"
    if podman load -i "$SEED_DIR/$file"; then
        touch "$marker"
    else
        log "ERROR: failed to import $name $version"
        rc=1
    fi
done < "$MANIFEST"

rm -rf "${TMPDIR:?}/"*

exit $rc
