#!/bin/sh
#
# Generate the shared PostgreSQL superuser password on first boot. Runs as
# ExecStartPre on foyer-postgres.container, so it always executes before the
# container starts but only ever writes the secret once — after that it is a
# no-op, so the superuser password (and therefore the data directory's own
# auth) never changes under it across reboots or A/B updates.

set -eu

ENV_FILE=/var/lib/foyer/secrets/postgres.env

if [ -e "$ENV_FILE" ]; then
    exit 0
fi

# BusyBox's head has no -c, so take a fixed byte count straight off od's -N
# instead of piping through tr -dc | head -c (which also isn't length-stable).
password=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')

umask 077
printf 'POSTGRES_PASSWORD=%s\n' "$password" > "$ENV_FILE"
chmod 0600 "$ENV_FILE"
