#!/bin/sh
#
# Walk /usr/lib/foyer/pg-databases.d and, for each app drop-in, idempotently
# create its PostgreSQL role and database and write its DATABASE_URL secret.
#
# Postgres's own /docker-entrypoint-initdb.d only runs against an empty data
# directory, so it cannot provision an app added after the first boot. This
# runs on every boot instead, gated per-app on the secret file it writes:
# once /var/lib/foyer/secrets/pg-<name>.env exists that app is left alone, so
# a restart or an A/B update never rotates a password or touches existing
# data. Role/database creation is additionally guarded on pg_roles/pg_database
# so a drop-in surviving from a previous provisioning (secret lost, role kept)
# does not fail on a duplicate CREATE.
#
# psql runs over the container's local unix socket as the postgres superuser,
# which needs no password — local auth in the upstream image defaults to
# trust/peer regardless of POSTGRES_HOST_AUTH_METHOD (that setting only
# affects host, i.e. network, connections).

set -eu

DROPIN_DIR=/usr/lib/foyer/pg-databases.d
SECRETS_DIR=/var/lib/foyer/secrets

log() {
    echo "foyer-pg-provision: $*"
}

psql_exec() {
    podman exec -i foyer-postgres psql -U postgres -v ON_ERROR_STOP=1 -tAc "$1"
}

random_password() {
    # BusyBox's head has no -c, so take a fixed byte count straight off od's
    # -N instead of piping through tr -dc | head -c (also not length-stable).
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
}

if [ ! -d "$DROPIN_DIR" ]; then
    log "no drop-in directory at $DROPIN_DIR, nothing to provision"
    exit 0
fi

for conf in "$DROPIN_DIR"/*.conf; do
    [ -e "$conf" ] || continue

    NAME=""
    . "$conf"

    if [ -z "$NAME" ]; then
        log "WARNING: $conf has no NAME=, skipping"
        continue
    fi

    env_file="$SECRETS_DIR/pg-$NAME.env"
    if [ -e "$env_file" ]; then
        log "$NAME already provisioned"
        continue
    fi

    password=$(random_password)

    if [ "$(psql_exec "SELECT 1 FROM pg_roles WHERE rolname='$NAME'")" = "1" ]; then
        psql_exec "ALTER ROLE \"$NAME\" PASSWORD '$password'"
    else
        psql_exec "CREATE ROLE \"$NAME\" LOGIN PASSWORD '$password'"
    fi

    if [ "$(psql_exec "SELECT 1 FROM pg_database WHERE datname='$NAME'")" != "1" ]; then
        psql_exec "CREATE DATABASE \"$NAME\" OWNER \"$NAME\""
    fi

    umask 077
    printf 'DATABASE_URL=postgresql://%s:%s@foyer-postgres:5432/%s\n' "$NAME" "$password" "$NAME" > "$env_file"
    chmod 0600 "$env_file"

    log "provisioned $NAME"
done
