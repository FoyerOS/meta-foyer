[Unit]
Description=Home Assistant
After=foyer-seed-import.service
Requires=foyer-seed-import.service
# /var/lib/homeassistant is a bind mount from the data partition; starting
# before it lands would give the container an empty config directory on the
# read-only rootfs.
RequiresMountsFor=/var/lib/homeassistant

[Container]
Image=localhost/homeassistant:2026.7.2
ContainerName=homeassistant
Network=host
Volume=/var/lib/homeassistant:/config
Environment=TZ=UTC
PodmanArgs=--privileged
PublishPort=8123:8123

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
