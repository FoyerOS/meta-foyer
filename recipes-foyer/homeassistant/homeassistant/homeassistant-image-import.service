[Unit]
Description=Import baked-in Home Assistant container image into podman storage
ConditionPathExists=!/var/lib/foyer/.homeassistant-imported
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/foyer/import-homeassistant-image
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
