[Unit]
Description=EFI System Partition
Documentation=man:systemd.mount(5)
# See the note in data.mount: without this, systemd stops the mount again once
# the boot moves past local-fs.target.
Before=local-fs.target

[Mount]
# Mounted at /efi rather than /boot on purpose: each root slot carries its own
# /boot/bzImage, and mounting the ESP over /boot would hide the kernel grub
# just loaded. RAUC writes its slot state to /efi/EFI/BOOT/grubenv, so this
# has to be writable.
# By GPT partition name, not filesystem label: this is the one vfat partition
# in the layout, and mkfs.fat warns that lowercase FAT labels "might not work
# properly on some systems" (FAT labels are 11 chars, uppercase-normalised on
# some tools). The ESP is never needed before udev, unlike foyer-config, so
# by-partlabel is available and unambiguous here.
What=/dev/disk/by-partlabel/esp
Where=/efi
Type=vfat
Options=umask=0077,noatime

[Install]
WantedBy=local-fs.target
